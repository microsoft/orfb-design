# Keep the Docker build context lean. Each server Dockerfile copies only the
# paths it needs; this excludes large/irrelevant trees from the context tarball.
.git
.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/build
**/dist
.pytest_cache
.ruff_cache
.mypy_cache
published_artifacts

# Never ship raw checkpoint archives (the extracted dirs are what get baked).
**/*.zip
